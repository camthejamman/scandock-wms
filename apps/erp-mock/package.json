{
  "name": "@scandock/erp-mock",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Nimbus ERP - a tiny stand-in for the ERP (NetSuite-like) that ScanDock syncs with",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "typescript": "~5.9.3"
  }
}
