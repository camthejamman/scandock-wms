{
  "name": "@scandock/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ScanDock WMS API (Fastify + Postgres)",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "NODE_OPTIONS=--import=tsx jasmine --config=jasmine.json"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.0",
    "@fastify/jwt": "^10.2.7",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/jasmine": "^7.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.0",
    "jasmine": "^7.0.0",
    "pino-pretty": "^13.2.0",
    "typescript": "~5.9.3"
  }
}
